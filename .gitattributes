# Auto detect text files and perform LF normalization
* text=auto

# C# source files
*.cs text diff=csharp
*.csproj text
*.sln text eol=crlf

# Configuration
*.json text
*.xml text
*.config text

# Documentation
*.md text
*.txt text

# Scripts
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.sh text eol=lf

# Inno Setup
*.iss text eol=crlf

# Binary files
*.exe binary
*.dll binary
*.pdb binary
*.ico binary
*.png binary
*.jpg binary
*.gif binary
